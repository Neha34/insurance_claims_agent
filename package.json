{
  "name": "insurance_claims_agent",
  "version": "1.0.0",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "uv run -m uvicorn backend.main:app --reload --reload-dir backend",
    "format": "uv run ruff format && prettier --write -u *.yml *.json *.md",
    "check": "npm run check:python",
    "check:python": "uv run ruff format --check && uv run ruff check && pyright && uv run pytest -q"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "pyright": "^1.1.414"
  }
}
