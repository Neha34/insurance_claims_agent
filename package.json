{
  "name": "insurance_claims_agent",
  "version": "1.0.0",
  "scripts": {
    "prepare": "lefthook install && playwright install chromium",
    "dev": "concurrently -k -n backend,dashboard npm:dev:backend npm:dev:dashboard",
    "format": "uv run ruff format && prettier --write -u dashboard e2e *.config.* *.json *.md *.yml",
    "check": "npm run check:python && npm run check:ts && npm run e2e",
    "check:python": "uv run ruff format --check && uv run ruff check && pyright && uv run pytest -q",
    "dev:backend": "uv run -m uvicorn backend.main:app --reload --reload-dir backend --reload-dir agent",
    "dev:dashboard": "vite dashboard",
    "check:ts": "prettier --check -u dashboard e2e *.config.* && eslint dashboard e2e *.config.* && tsc && vitest run --root dashboard --coverage",
    "e2e": "playwright test"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "pyright": "^1.1.414",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
